{
  "name": "open-reader",
  "description": "Offline, reliable read-aloud for web pages and PDFs.",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.9.0",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "build:test": "wxt build --mode test",
    "zip": "wxt zip",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "wxt build --mode test && playwright test",
    "postinstall": "wxt prepare",
    "icons": "tsx scripts/make-icons.ts",
    "prepare": "lefthook install",
    "licenses:check": "tsx scripts/check-licenses.ts",
    "spikes:build": "wxt build spikes/extension",
    "spikes:run": "tsx spikes/run.ts",
    "spikes:setup": "tsx spikes/setup.ts",
    "test:soak": "wxt build --mode test && SOAK_MINUTES=10 playwright test soak",
    "test:models": "wxt build --mode test && playwright test --config playwright.models.config.ts",
    "models:fetch": "tsx scripts/fetch-models.ts",
    "build:offline": "OPEN_READER_OFFLINE=1 wxt build",
    "synth:corpus": "tsx scripts/synth-corpus.ts",
    "quality": "uv run --project quality --python 3.12 python quality/asr_qa.py",
    "fixtures": "tsx scripts/make-fixtures.ts",
    "budgets": "tsx scripts/check-budgets.ts"
  },
  "dependencies": {
    "@diffusionstudio/piper-wasm": "1.0.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@mozilla/readability": "0.6.0",
    "@tesseract.js-data/eng": "1.0.0",
    "clsx": "2.1.1",
    "comlink": "4.4.2",
    "idb": "8.0.4",
    "lucide-react": "1.63.0",
    "onnxruntime-web": "1.31.1",
    "pdfjs-dist": "6.4.299",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tesseract.js": "7.0.0",
    "tesseract.js-core": "7.0.0",
    "wasm-media-encoders": "0.7.0",
    "xstate": "5.33.3",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "@wxt-dev/module-react": "1.2.2",
    "@xstate/graph": "3.0.4",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.6",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "happy-dom": "21.0.4",
    "lefthook": "2.2.2",
    "music-metadata": "12.3.2",
    "pdf-lib": "1.17.1",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5",
    "wxt": "0.21.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lefthook",
      "spawn-sync"
    ]
  }
}
